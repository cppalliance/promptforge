{
  "name": "promptforge-gateway-config-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PromptForge Gateway Config UI: TypeScript sources bundled by esbuild into dist/ and served by promptforge-gateway-config-ui.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --package",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check-layers": "node check-layers.mjs",
    "pretest": "npm run check-layers",
    "test": "node --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "gray-matter": "^4.0.3",
    "lucide": "^1.37.0",
    "markdown-it": "^15.0.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  }
}
