[Unit]
Description=Runvil inference gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/runvil-gateway --config /etc/runvil/gateway.toml --profile main
Restart=on-failure
RestartSec=5
# The gateway holds vendor credentials; run it as a dedicated user.
DynamicUser=yes
StateDirectory=runvil

[Install]
WantedBy=multi-user.target
